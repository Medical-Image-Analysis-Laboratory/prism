# Loaded by python-dotenv at the start of train.py / inference.py.
# Copy and adapt; nothing here is machine-specific by default.

# Non-interactive matplotlib backend (validation figures are logged, not shown).
MPLBACKEND=Agg

# GPU architectures the CUDA extensions are compiled for. Leave unset to let
# PyTorch detect the local GPU; set it when building for other hardware, e.g.
#   8.9 = RTX 40xx / L40, 8.6 = A40 / RTX 30xx, 8.0 = A100, 7.5 = T4 / RTX 20xx
# TORCH_CUDA_ARCH_LIST=8.9

# --- dataset roots (see configs/paths/default.yaml and the README) -----------
# PRISM_TRAIN_DATA=/data/reference_volumes
# PRISM_SIM_TEST_DATA=/data/simulated_test
# PRISM_REAL_DATA=/data/clinical_bids
# PRISM_PREDICTIONS=/data/predictions

# --- training only -----------------------------------------------------------
# PRISM_INIT_CKPT=/weights/prism_init.ckpt
# MEDICALNET_WEIGHTS=/weights/resnet_10_23dataset.pth
# MEDICALNET_REPO=/opt/MedicalNet-models
